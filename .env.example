# Copy this file to .env on each node and replace every placeholder.
# Node-local paths may differ. Distributed settings and RUN_ID must match.

PROJECT_ROOT=/absolute/path/to/SPARSE
PYTHON_BIN=/absolute/path/to/conda/env/bin/python
CUDA_VISIBLE_DEVICES=0,1
NODE_RANK=0
NNODES=2
NPROC_PER_NODE=2
EP_SIZE=4
MASTER_ADDR=REPLACE_WITH_NODE0_ADDRESS
MASTER_PORT=29671
NCCL_SOCKET_IFNAME=REPLACE_WITH_INTERFACE
NCCL_IB_DISABLE=1

# Used only by scripts/run/launch_two_node.sh on node 0.
REMOTE_SSH=REPLACE_WITH_SSH_ALIAS
REMOTE_REPO=/absolute/path/to/SPARSE
REMOTE_ENV_FILE=.env
REMOTE_RESULTS_ROOT=/absolute/path/to/SPARSE/results/local

MODEL_KEY=qwen
MODEL_PATH=/absolute/path/to/Qwen1.5-MoE-A2.7B
MODEL_NUM_LAYERS=24
MODEL_NUM_EXPERTS=60

C4_PROFILE_TRAIN=/absolute/path/to/c4_profile_train.jsonl.gz
C4_PROFILE_VALID=/absolute/path/to/c4_profile_valid.jsonl.gz
C4_RUNTIME=/absolute/path/to/c4_runtime_eval.jsonl.gz
LONGBENCH_RUNTIME=/absolute/path/to/longbench_runtime_eval.jsonl.gz

RESULTS_ROOT=$PROJECT_ROOT/results/local
NETWORK_LABEL=physical-400mbps
NETWORK_INTERFACE=REPLACE_WITH_INTERFACE
TOPOLOGY_PATH=$PROJECT_ROOT/configs/topology_400mbps_paper.json

SCP_PROFILE_ROOT=$RESULTS_ROOT/offline/scp/$MODEL_KEY
SCP_TRAIN_PROFILE=$SCP_PROFILE_ROOT/grouped/profile_train_grouped.npz
SCP_VALID_PROFILE=$SCP_PROFILE_ROOT/grouped/profile_valid_grouped.npz
SCP_PATH=$RESULTS_ROOT/offline/scp/$MODEL_KEY/placement.json
RS_PROFILE_DIR=$RESULTS_ROOT/offline/rs/$MODEL_KEY/profile
RS_DIR=$RESULTS_ROOT/offline/rs/$MODEL_KEY/checkpoints

# Optional controlled baseline files.
EPLB_PATH=$RESULTS_ROOT/offline/baselines/$MODEL_KEY/eplb.json
PRISM_PATH=$RESULTS_ROOT/offline/baselines/$MODEL_KEY/prism.json
HOT_PROFILE_PATH=$RESULTS_ROOT/offline/baselines/$MODEL_KEY/hot_experts.json
MOE_INFINITY_EAMC_PATH=$RESULTS_ROOT/offline/baselines/$MODEL_KEY/moe_infinity_eamc.json

# ProMoE-style predictors are separate from RS. Topology is selected later;
# run_promoe.sh accepts any explicitly configured EP world size.
PROMOE_PROFILE_DIR=$RESULTS_ROOT/offline/promoe/$MODEL_KEY/profile
PROMOE_DIR=$RESULTS_ROOT/offline/promoe/$MODEL_KEY/checkpoints
PROMOE_DISTANCE=2
PROMOE_HIDDEN_DIM=1024
PROMOE_CPU_THREADS=1
PROMOE_PREDICT_PREFILL=0

# Frozen homogeneous protocol.
EXPERT_CACHE=8
CACHE_BY_RANK=8,8,8,8
PREFETCH_TOP_M=2
PREDICTION_TOP_K=4
WARMUP=1
REPEAT=3
REQUEST_GROUP_STRIDE=32
MAX_SCAN_SAMPLES=2000

# Offline RS defaults. Override only when reproducing another model manifest.
RS_MODEL_ARCH=residual
RS_HIDDEN_DIM=512
RS_NUM_HIDDEN_LAYERS=2
RS_BATCH_SIZE=512
RS_EPOCHS=40
RS_DECODE_STEPS=64
RS_NUM_SAMPLES=4096
